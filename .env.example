# ===== 应收应付对账系统 环境配置（示例） =====
# 使用方式：复制本文件为 .env 后按需修改。.env 已在 .gitignore 中排除，不会被提交。

# ---------------- 数据库 ----------------
# 留空则自动使用「项目根目录/data/app.db」（推荐，整个文件夹可搬移）。
# DATABASE_URL=sqlite:///D:/your/path/app.db
#
# 切换到 MySQL（代码已支持，无需改动业务代码）：
# DATABASE_URL=mysql+pymysql://root:密码@127.0.0.1:3306/ar_ap?charset=utf8mb4

# ---------------- 本方主体 ----------------
# 用于判定销项/进项、应收/应付，以及流水方向。
# 名称关键词：购方或销方名称包含任一关键词即视为本方
SELF_KEYWORDS=示例科技
# 纳税人识别号：精确识别，优先级高于关键词
SELF_TAX_IDS=91110108MA0EXAMPLE

# ---------------- 其他 ----------------
# 默认操作人（MVP 单人使用）
DEFAULT_OPERATOR=admin
# 对账候选匹配：金额相对偏差阈值 5%
CANDIDATE_TOLERANCE=0.05
# 服务地址
HOST=0.0.0.0
PORT=8000
